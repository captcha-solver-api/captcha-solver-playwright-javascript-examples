CAPTCHA_API_KEY=your_captcha_solver_api_key
HEADLESS=false
# Before running, set the matching *_TARGET_URL to the page you want to test.
# Replace example.com placeholders with your own URL; these pages do not contain CAPTCHA demos.
# Use a public demo or a page you own or are authorized to test.
RECAPTCHA_V2_TARGET_URL=https://www.google.com/recaptcha/api2/demo
RECAPTCHA_ENTERPRISE_TARGET_URL=https://example.com/page_with_recaptcha_v2_enterprise
RECAPTCHA_V3_TARGET_URL=https://example.com/page_with_recaptcha_v3
TURNSTILE_TARGET_URL=https://example.com/page_with_turnstile
TURNSTILE_CHALLENGE_TARGET_URL=https://example.com/page_with_turnstile_challenge
YANDEX_TARGET_URL=https://captcha-api.yandex.ru/demo
TENCENT_TARGET_URL=https://example.com/page_with_tencent_captcha
TENCENT_SCRIPT_URL=
GEETEST_V3_TARGET_URL=https://example.com/page_with_geetest_v3
GEETEST_V4_TARGET_URL=https://example.com/page_with_geetest_v4
